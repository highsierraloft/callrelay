# Allowlist: only Dockerfile COPY inputs and the Dockerfile itself enter the
# Docker/Fly build context. Git, env files, caches, databases, and the rest
# of the tree stay out.

*

!Dockerfile
!Dockerfile.asterisk
!Dockerfile.android
!pyproject.toml
!uv.lock
!README.md
!requirements-android.txt

!deploy/
deploy/**
!deploy/asterisk/
!deploy/asterisk/entrypoint.py
!deploy/asterisk/sounds/
!deploy/asterisk/sounds/**

!app/
!app/**

!scripts/
scripts/**
!scripts/agent_call_console.py
!scripts/container-entrypoint.sh

!Dockerfile.control
!Dockerfile.control-tests
!deploy/control/
!deploy/control/**
!dashboard/
!dashboard/**

# Re-exclude secrets, VCS, caches, and runtime data even under allowed paths.
**/.git
**/.git/**
**/.env
**/.env.*
**/.venv
**/.venv/**
**/__pycache__/
**/__pycache__/**
**/*.py[cod]
**/.pytest_cache/
**/.pytest_cache/**
**/.mypy_cache/
**/.mypy_cache/**
**/.ruff_cache/
**/.ruff_cache/**
**/.coverage
**/.coverage*
**/htmlcov/
**/htmlcov/**
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db-journal
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
**/*.log
**/logs
**/logs/**
**/transcripts
**/transcripts/**
**/data
**/data/**

**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/test-results
**/test-results/**
**/playwright-report
**/playwright-report/**

**/private
**/private/**
**/.release
**/.release/**
**/*-api-key
**/control-access.json
**/agent-call.json
**/asterisk.json
**/worker-asterisk.json
**/adbkey*
**/*.key
**/*.pem
**/*.keystore
**/*.jks
